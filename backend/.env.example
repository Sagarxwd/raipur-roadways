# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/raipur-bilty?retryWrites=true&w=majority

# Strong random secret key for signing JWTs
JWT_SECRET=generate-a-strong-secret-key-for-jwt

# Port (defaults to 8000 locally, set automatically by host in production)
PORT=8000

# Next consignment note number to start from (only used before the first note is saved)
START_LR=1

# Logins created/updated by "npm run seed"
ADMIN_USER=admin
ADMIN_PASSWORD=change-to-secure-password
OPERATOR_USER=operator
OPERATOR_PASSWORD=change-to-secure-password
